+def system_llama_server() -> Path | None:
+    """Prefer the distro llama-cpp-server binary (PGO, system ggml)."""
+    candidates = [Path("/usr/bin/llama-server")]
+    which = shutil.which("llama-server")
+    if which:
+        candidates.append(Path(which))
+    for p in candidates:
+        if p.is_file() and os.access(p, os.X_OK):
+            return p
+    return None
+
+
 def server_binary(install_dir: Path) -> Path:
     """Locate llama-server within an extracted runtime (zips differ in whether they nest a
     build/bin directory)."""
+    sys_bin = system_llama_server()
